diff --git a/lib/mosquitto_internal.h b/lib/mosquitto_internal.h
index 3112025..d8a81fd 100644
--- a/lib/mosquitto_internal.h
+++ b/lib/mosquitto_internal.h
@@ -208,6 +208,12 @@ struct mosquitto_msg_data{
 };
 
 
+#ifdef WITH_BROKER
+#  define MOSQ_SOCK_READ_PENDING(m) ((m)->sock_read_pos < (m)->sock_read_end)
+#else
+#  define MOSQ_SOCK_READ_PENDING(m) 0
+#endif
+
 struct mosquitto {
 #if defined(WITH_BROKER) && defined(WITH_EPOLL)
 	/* This *must* be the first element in the struct. */
@@ -285,6 +291,12 @@ struct mosquitto {
 	bool in_by_id;
 	bool is_dropping;
 	bool is_bridge;
+	/* Userspace read-ahead: packet__read consumes the MQTT header one byte
+	 * at a time. Without this, each of those is a read(2). */
+	uint8_t *sock_read_buf;
+	uint32_t sock_read_size;
+	uint32_t sock_read_pos;
+	uint32_t sock_read_end;
 	struct mosquitto__bridge *bridge;
 	struct mosquitto_msg_data msgs_in;
 	struct mosquitto_msg_data msgs_out;
diff --git a/lib/net_mosq.c b/lib/net_mosq.c
index fb0c7ac..d84fdd9 100644
--- a/lib/net_mosq.c
+++ b/lib/net_mosq.c
@@ -966,6 +966,10 @@ static int net__handle_ssl(struct mosquitto* mosq, int ret)
 }
 #endif
 
+#ifdef WITH_BROKER
+#  define MOSQ_SOCK_READ_BUF 8192
+#endif
+
 ssize_t net__read(struct mosquitto *mosq, void *buf, size_t count)
 {
 #ifdef WITH_TLS
@@ -987,7 +991,48 @@ ssize_t net__read(struct mosquitto *mosq, void *buf, size_t count)
 #endif
 
 #ifndef WIN32
+#ifdef WITH_BROKER
+	{
+		uint8_t *dst = buf;
+		size_t copied = 0;
+		if(mosq->sock_read_pos < mosq->sock_read_end){
+			size_t avail = mosq->sock_read_end - mosq->sock_read_pos;
+			size_t take = avail < count ? avail : count;
+			memcpy(dst, mosq->sock_read_buf + mosq->sock_read_pos, take);
+			mosq->sock_read_pos += (uint32_t)take;
+			copied = take;
+			if(copied == count){
+				return (ssize_t)copied;
+			}
+			dst += take;
+			count -= take;
+		}
+		if(!mosq->sock_read_buf){
+			mosq->sock_read_buf = mosquitto__malloc(MOSQ_SOCK_READ_BUF);
+			if(!mosq->sock_read_buf){
+				if(copied){
+					return (ssize_t)copied;
+				}
+				return read(mosq->sock, dst, count);
+			}
+			mosq->sock_read_size = MOSQ_SOCK_READ_BUF;
+		}
+		{
+			ssize_t n = read(mosq->sock, mosq->sock_read_buf, mosq->sock_read_size);
+			if(n <= 0){
+				return copied ? (ssize_t)copied : n;
+			}
+			mosq->sock_read_pos = 0;
+			mosq->sock_read_end = (uint32_t)n;
+			size_t take = (size_t)n < count ? (size_t)n : count;
+			memcpy(dst, mosq->sock_read_buf, take);
+			mosq->sock_read_pos = (uint32_t)take;
+			return (ssize_t)(copied + take);
+		}
+	}
+#else
 	return read(mosq->sock, buf, count);
+#endif
 #else
 	return recv(mosq->sock, buf, count, 0);
 #endif
