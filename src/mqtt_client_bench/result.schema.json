{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yoch/mqtt-python-client-bench/main/src/mqtt_client_bench/result.schema.json",
  "title": "MQTT Python client benchmark result",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "scenario": { "type": "string" },
    "profile": { "type": "string", "enum": ["standard", "smoke"] },
    "runs": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer" },
    "client": {
      "type": "string",
      "enum": ["paho", "gmqtt", "aiomqtt", "amqtt", "awscrt", "zmqtt", "aiomqtt3", "mqttium", "mqttium-compat"]
    },
    "client_path": { "type": ["string", "null"] },
    "client_identity": { "type": "object" },
    "baseline_client": { "type": "string" },
    "candidate_client": { "type": "string" },
    "baseline_identity": { "type": "object" },
    "candidate_identity": { "type": "object" },
    "cooldown_s": { "type": "number" },
    "broker": { "type": "object" },
    "loadgen": { "type": "object" },
    "environment": { "type": "object" },
    "cpusets": { "type": "object" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["point", "runs"],
        "properties": {
          "point": { "type": "object" },
          "runs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["schema_version", "run_id", "status"],
              "properties": {
                "schema_version": { "type": "integer" },
                "run_id": { "type": "string", "minLength": 8, "maxLength": 8 },
                "status": { "type": "string", "enum": ["valid", "inconclusive"] },
                "reasons": { "type": "array", "items": { "type": "string" } },
                "client": { "type": "string" },
                "primary_msgs_per_s": { "type": ["number", "null"] },
                "secondary_msgs_per_s": { "type": "object" },
                "workers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": { "type": "string" },
                      "ok": { "type": "boolean" },
                      "offered": { "type": "integer" },
                      "submitted": { "type": "integer" },
                      "sync_rejected": { "type": "integer" },
                      "completed_success": { "type": "integer" },
                      "completed_failed": { "type": "integer" },
                      "missed_due_to_backpressure": { "type": "integer" },
                      "msgs_per_s": { "type": ["number", "null"] },
                      "integrity": { "type": "object" },
                      "latency_summary": { "type": "object" }
                    }
                  }
                },
                "loadgen": { "type": ["object", "null"] },
                "telemetry": { "type": "array" },
                "non_comparable": { "type": "boolean" },
                "protocol_effective": { "type": "string" },
                "publish_path": {
                  "description": "How the publisher drove the client: on the role worker's own asyncio loop, or through the sync facade and its bridge thread. The two measure different amounts of harness and are never comparable with each other.",
                  "type": ["string", "null"],
                  "enum": ["native_async", "sync_facade", null]
                },
                "bottleneck": {
                  "type": "string",
                  "enum": [
                    "sut_limited",
                    "broker_limited",
                    "broker_unconfirmed",
                    "loadgen_limited",
                    "offer_limited",
                    "bottleneck_unattributed"
                  ]
                },
                "broker_cpu_max_pct": { "type": ["number", "null"] },
                "broker_reconciliation": {
                  "type": ["object", "null"],
                  "description": "Adapter-reported completions vs the broker's $SYS received-publish counter.",
                  "properties": {
                    "applicable": { "type": "boolean" },
                    "reason": { "type": ["string", "null"] },
                    "completed": { "type": ["integer", "null"] },
                    "broker_received": { "type": ["integer", "null"] },
                    "ratio": { "type": ["number", "null"] }
                  }
                },
                "cost_per_message": {
                  "type": ["object", "null"],
                  "description": "Total SUT CPU over the measure window per logical message.",
                  "properties": {
                    "cpu_ns_in_window": { "type": "integer" },
                    "messages": { "type": "integer" },
                    "published": { "type": "integer" },
                    "delivered": { "type": "integer" },
                    "cpu_us_per_message": { "type": ["number", "null"] },
                    "rss_peak_kb": { "type": ["integer", "null"] }
                  }
                },
                "started_at": { "type": "string" },
                "finished_at": { "type": "string" },
                "host_state": {
                  "type": ["object", "null"],
                  "properties": {
                    "scaling_governor": { "type": ["string", "null"] },
                    "loadavg": { "type": "array" },
                    "cpu_count": { "type": ["integer", "null"] }
                  }
                }
              }
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "n": { "type": "integer" },
              "median": { "type": ["number", "null"] },
              "inconclusive_n": { "type": "integer" },
              "total_runs": { "type": "integer" }
            }
          }
        }
      }
    },
    "points": { "type": "array" },
    "verdict": { "type": "object" },
    "order": { "type": "array", "items": { "type": "string", "enum": ["A", "B"] } }
  }
}
